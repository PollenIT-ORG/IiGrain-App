<resources>

    <!-- Base application theme.
         Light-only: the app never follows the OS dark theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>

        <!-- WHITE window background so the very first frames (before JS paints) are
             white - never a blank/dark frame that an OEM would cover with its own
             "loading" ring. -->
        <item name="android:windowBackground">@android:color/white</item>

        <!-- Force light mode app-wide (belt-and-suspenders alongside the Light parent). -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- Status bar = primary green with LIGHT (white) icons.
             On Android 15+ the OS forces edge-to-edge and IGNORES statusBarColor -
             the JS StatusBarBackground overlay paints the strip there. On Android <15
             (opaque status bar) this colours it directly. windowLightStatusBar=false
             keeps the clock/icons white for contrast on the dark green. -->
        <item name="android:statusBarColor">#167A45</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Native splash theme (androidx core-splashscreen).
         Applied to MainActivity as its launch theme; the OS paints the leaf
         icon on a white background BEFORE React Native starts, then
         installSplashScreen() swaps to @style/AppTheme (postSplashScreenTheme)
         the moment RN is ready. Backported to all versions by the library, and
         mapped to the real Android 12+ platform SplashScreen on API 31+.
         The leaf logo (@drawable/splash_icon) and the iOS LaunchScreen share one
         master asset - see scripts/gen_splash_assets.py. -->
    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
