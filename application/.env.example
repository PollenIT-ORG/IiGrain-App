# ─────────────────────────────────────────────
# iiGrain mobile - client environment template.
# Copy to `.env` and adjust. `.env` itself is gitignored.
# The app uses ONE hosted backend everywhere (no localhost).
# ─────────────────────────────────────────────

# Backend origin (host only, NO trailing slash, NO /api/v1).
API_BASE_URL=https://api.farmer.tcqitsolution.com

# API version prefix (matches backend API_PREFIX).
API_PREFIX=/api/v1

# Request timeout in milliseconds.
API_TIMEOUT=15000

# ─────────────────────────────────────────────
# Google Maps Platform
# ─────────────────────────────────────────────
# ONE key, read by three consumers (see docs/maps/CONFIGURATION.md):
#   1. Gradle  → AndroidManifest com.google.android.geo.API_KEY  (native tiles)
#   2. Podfile → Config/Env.generated.xcconfig → Info.plist GMSApiKey (native tiles)
#   3. Babel   → `@env` → src/config/env.ts   (Directions API, from JS)
# Required Google Cloud APIs: Maps SDK for Android, Maps SDK for iOS,
# Directions API. Restrict the key by package name + SHA-1 (Android) and bundle
# id (iOS) before shipping — see docs/maps/SECURITY.md.
# Leave EMPTY here. This file is committed — put the real key in `.env` only.
MAPS_API_KEY=

