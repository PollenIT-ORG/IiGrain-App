{
  "v": 1,
  "name": "Farmer App - Field/Farm/Soil/Assessment updates",
  "folders": [],
  "requests": [
    {
      "v": "1",
      "name": "Create farm with Business Entity [mobile]",
      "method": "POST",
      "endpoint": "<<baseUrl>>/farms/me/farms",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json",
          "active": true,
          "description": ""
        }
      ],
      "params": [],
      "body": {
        "contentType": "application/json",
        "body": "{\n  \"name\": \"Green Acres\",\n  \"areaAcres\": 100,\n  \"businessEntity\": \"Green Agro Pvt Ltd\"\n}"
      },
      "auth": {
        "authType": "bearer",
        "authActive": true,
        "token": "<<token>>"
      },
      "preRequestScript": "",
      "testScript": "pw.test('201', () => pw.expect(pw.response.status).toBe(201));\nconst f = pw.response.body.data && pw.response.body.data.farm;\nif (f) pw.env.set('farmId', f.id);"
    },
    {
      "v": "1",
      "name": "Get soil (shows locked flag)",
      "method": "GET",
      "endpoint": "<<baseUrl>>/fields/<<fieldId>>/soil",
      "headers": [],
      "params": [],
      "body": {
        "contentType": null,
        "body": null
      },
      "auth": {
        "authType": "bearer",
        "authActive": true,
        "token": "<<token>>"
      },
      "preRequestScript": "",
      "testScript": "pw.test('200', () => pw.expect(pw.response.status).toBe(200));\n/* data: { soil, locked } */"
    },
    {
      "v": "1",
      "name": "Save soil nutrients (403 if locked)",
      "method": "PUT",
      "endpoint": "<<baseUrl>>/fields/<<fieldId>>/soil",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json",
          "active": true,
          "description": ""
        }
      ],
      "params": [],
      "body": {
        "contentType": "application/json",
        "body": "{\n  \"ph\": 6.5,\n  \"organicMatter\": 3.2,\n  \"nitrogen\": 40,\n  \"phosphorus\": 20,\n  \"potassium\": 15,\n  \"moisture\": 22\n}"
      },
      "auth": {
        "authType": "bearer",
        "authActive": true,
        "token": "<<token>>"
      },
      "preRequestScript": "",
      "testScript": ""
    },
    {
      "v": "1",
      "name": "Discard in-progress assessment",
      "method": "DELETE",
      "endpoint": "<<baseUrl>>/assessments/my/programs/<<programId>>/fields/<<fieldId>>/discard",
      "headers": [],
      "params": [],
      "body": {
        "contentType": null,
        "body": null
      },
      "auth": {
        "authType": "bearer",
        "authActive": true,
        "token": "<<token>>"
      },
      "preRequestScript": "",
      "testScript": "pw.test('200 or 409', () => pw.expect([200,409]).toContain(pw.response.status));"
    },
    {
      "v": "1",
      "name": "Self-unenroll field from program [farmer]",
      "method": "DELETE",
      "endpoint": "<<baseUrl>>/programs/<<programId>>/fields/<<fieldId>>/unenroll",
      "headers": [],
      "params": [],
      "body": { "contentType": null, "body": null },
      "auth": { "authType": "bearer", "authActive": true, "token": "<<token>>" },
      "preRequestScript": "",
      "testScript": "pw.test('200/409', () => pw.expect([200,409]).toContain(pw.response.status));\n/* not started -> 200; in progress -> 409 discard first; submitted -> 409 cannot unenroll */"
    },
    {
      "v": "1",
      "name": "Reset field [mobile]",
      "method": "POST",
      "endpoint": "<<baseUrl>>/farms/<<farmId>>/fields/<<fieldId>>/reset",
      "headers": [],
      "params": [],
      "body": {
        "contentType": null,
        "body": null
      },
      "auth": {
        "authType": "bearer",
        "authActive": true,
        "token": "<<token>>"
      },
      "preRequestScript": "",
      "testScript": ""
    },
    {
      "v": "1",
      "name": "Delete field [mobile, guarded]",
      "method": "DELETE",
      "endpoint": "<<baseUrl>>/farms/<<farmId>>/fields/<<fieldId>>",
      "headers": [],
      "params": [],
      "body": {
        "contentType": null,
        "body": null
      },
      "auth": {
        "authType": "bearer",
        "authActive": true,
        "token": "<<token>>"
      },
      "preRequestScript": "",
      "testScript": "pw.test('200 or 409', () => pw.expect([200,409]).toContain(pw.response.status));"
    },
    {
      "v": "1",
      "name": "Reset farm [mobile]",
      "method": "POST",
      "endpoint": "<<baseUrl>>/farms/me/farms/<<farmId>>/reset",
      "headers": [],
      "params": [],
      "body": {
        "contentType": null,
        "body": null
      },
      "auth": {
        "authType": "bearer",
        "authActive": true,
        "token": "<<token>>"
      },
      "preRequestScript": "",
      "testScript": ""
    },
    {
      "v": "1",
      "name": "Delete farm [mobile, guarded]",
      "method": "DELETE",
      "endpoint": "<<baseUrl>>/farms/me/farms/<<farmId>>",
      "headers": [],
      "params": [],
      "body": {
        "contentType": null,
        "body": null
      },
      "auth": {
        "authType": "bearer",
        "authActive": true,
        "token": "<<token>>"
      },
      "preRequestScript": "",
      "testScript": "pw.test('200 or 409', () => pw.expect([200,409]).toContain(pw.response.status));"
    }
  ]
}
