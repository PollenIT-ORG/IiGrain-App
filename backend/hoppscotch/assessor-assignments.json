{
  "v": 1,
  "name": "Farmer App - Assessor Assignments",
  "folders": [
    {
      "v": 1,
      "name": "Admin / Program Admin",
      "folders": [],
      "requests": [
        {
          "v": "1",
          "name": "Assign assessor to farmer",
          "method": "POST",
          "endpoint": "<<baseUrl>>/assessor-assignments",
          "headers": [{ "key": "Content-Type", "value": "application/json", "active": true, "description": "" }],
          "params": [],
          "body": {
            "contentType": "application/json",
            "body": "{\n  \"assessorId\": \"<<assessorId>>\",\n  \"farmerId\": \"<<farmerId>>\",\n  \"note\": \"Quarterly soil-health visit\"\n}"
          },
          "auth": { "authType": "bearer", "authActive": true, "token": "<<token>>" },
          "preRequestScript": "",
          "testScript": "pw.test(\"save assignmentId\", () => {\n  const d = pw.response.body.data;\n  if (d && d.assignment && d.assignment.id) pw.env.set('assignmentId', d.assignment.id);\n});"
        },
        {
          "v": "1",
          "name": "List assignments (filter by assessor / farmer)",
          "method": "GET",
          "endpoint": "<<baseUrl>>/assessor-assignments",
          "headers": [],
          "params": [
            { "key": "page",       "value": "1",              "active": true,  "description": "" },
            { "key": "limit",      "value": "10",             "active": true,  "description": "" },
            { "key": "assessorId", "value": "<<assessorId>>", "active": false, "description": "" },
            { "key": "farmerId",   "value": "<<farmerId>>",   "active": false, "description": "" }
          ],
          "body": { "contentType": null, "body": null },
          "auth": { "authType": "bearer", "authActive": true, "token": "<<token>>" },
          "preRequestScript": "",
          "testScript": ""
        },
        {
          "v": "1",
          "name": "Unassign (remove assignment)",
          "method": "DELETE",
          "endpoint": "<<baseUrl>>/assessor-assignments/<<assignmentId>>",
          "headers": [],
          "params": [],
          "body": { "contentType": null, "body": null },
          "auth": { "authType": "bearer", "authActive": true, "token": "<<token>>" },
          "preRequestScript": "",
          "testScript": ""
        }
      ]
    },
    {
      "v": 1,
      "name": "Admin - Create roles (reference)",
      "folders": [],
      "requests": [
        {
          "v": "1",
          "name": "Create program administrator (admin/super only)",
          "method": "POST",
          "endpoint": "<<baseUrl>>/users",
          "headers": [{ "key": "Content-Type", "value": "application/json", "active": true, "description": "" }],
          "params": [],
          "body": {
            "contentType": "application/json",
            "body": "{\n  \"fullName\": \"Program Admin\",\n  \"email\": \"progadmin@example.com\",\n  \"phone\": \"+919876543210\",\n  \"password\": \"secret123\",\n  \"role\": \"program_administrator\"\n}"
          },
          "auth": { "authType": "bearer", "authActive": true, "token": "<<token>>" },
          "preRequestScript": "",
          "testScript": ""
        },
        {
          "v": "1",
          "name": "Create assessor (auto-assigned to default org)",
          "method": "POST",
          "endpoint": "<<baseUrl>>/users",
          "headers": [{ "key": "Content-Type", "value": "application/json", "active": true, "description": "" }],
          "params": [],
          "body": {
            "contentType": "application/json",
            "body": "{\n  \"fullName\": \"Visit Assessor\",\n  \"email\": \"assessor1@example.com\",\n  \"phone\": \"+919876500011\",\n  \"password\": \"secret123\",\n  \"role\": \"assessor\"\n}"
          },
          "auth": { "authType": "bearer", "authActive": true, "token": "<<token>>" },
          "preRequestScript": "",
          "testScript": "pw.test(\"save assessorId\", () => {\n  const d = pw.response.body.data;\n  if (d && d.user && d.user.id) pw.env.set('assessorId', d.user.id);\n});"
        },
        {
          "v": "1",
          "name": "Create farmer (auto-assigned to default org)",
          "method": "POST",
          "endpoint": "<<baseUrl>>/users",
          "headers": [{ "key": "Content-Type", "value": "application/json", "active": true, "description": "" }],
          "params": [],
          "body": {
            "contentType": "application/json",
            "body": "{\n  \"fullName\": \"Field Farmer\",\n  \"email\": \"farmer1@example.com\",\n  \"phone\": \"+919876500022\",\n  \"password\": \"secret123\",\n  \"role\": \"farmer\"\n}"
          },
          "auth": { "authType": "bearer", "authActive": true, "token": "<<token>>" },
          "preRequestScript": "",
          "testScript": "pw.test(\"save farmerId\", () => {\n  const d = pw.response.body.data;\n  if (d && d.user && d.user.id) pw.env.set('farmerId', d.user.id);\n});"
        }
      ]
    }
  ],
  "requests": []
}
