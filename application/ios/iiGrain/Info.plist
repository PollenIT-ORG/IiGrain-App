<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>iiGrain</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Google Maps iOS SDK key.
	     NOT read by the SDK itself — the SDK has no Info.plist convention. This
	     entry exists purely as the transport that carries the key from the build
	     system into Swift: AppDelegate.swift reads it and calls
	     GMSServices.provideAPIKey().
	     $(MAPS_API_KEY_IOS) is a BUILD SETTING, expanded by Xcode at build time. It
	     is defined in ios/Config/Env.generated.xcconfig, which ios/Podfile
	     regenerates from .env on every `pod install`. Never paste a literal key
	     here — Info.plist is committed to git. -->
	<key>GMSApiKey</key>
	<string>$(MAPS_API_KEY_IOS)</string>
	<key>NSCameraUsageDescription</key>
	<string>iiGrain needs camera access so you can take photos and record videos for your farms, fields and assessments.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>iiGrain needs your location so you can pin farms and fields on the map and record where assessments were carried out.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>iiGrain needs your location so you can pin farms and fields on the map and record where assessments were carried out.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>iiGrain needs microphone access so recorded assessment videos include sound.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>iiGrain needs permission to save photos to your library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>iiGrain needs photo and video library access so you can attach media to your farms, fields and assessments.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- The app ships one light design. Without this, system-drawn surfaces and
	     any semantic colour resolve dark on dark-mode devices. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIAppFonts</key>
	<array>
		<string>MaterialCommunityIcons.ttf</string>
		<string>Inter-Bold.ttf</string>
		<string>Inter-Medium.ttf</string>
		<string>Inter-Regular.ttf</string>
		<string>Inter-SemiBold.ttf</string>
	</array>
</dict>
</plist>
