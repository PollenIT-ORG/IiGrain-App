  assessor_id                           String                  @db.Uuid
  farmer_id                             String                  @db.Uuid
  program_id                            String?                 @db.Uuid
  field_id                              String?                 @db.Uuid
  status                                String                  @default("en_route") @db.VarChar(20)
  dest_latitude                         Decimal?                @db.Decimal(9, 6)
  dest_longitude                        Decimal?                @db.Decimal(9, 6)
  last_latitude                         Decimal?                @db.Decimal(9, 6)
  last_longitude                        Decimal?                @db.Decimal(9, 6)
  last_location_at                      DateTime?               @db.Timestamptz(6)
  started_at                            DateTime                @default(now()) @db.Timestamptz(6)
  arrived_at                            DateTime?               @db.Timestamptz(6)
  ended_at                              DateTime?               @db.Timestamptz(6)
  created_at                            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime                @default(now()) @db.Timestamptz(6)
  arrival_latitude                      Decimal?                @db.Decimal(9, 6)
  arrival_longitude                     Decimal?                @db.Decimal(9, 6)
