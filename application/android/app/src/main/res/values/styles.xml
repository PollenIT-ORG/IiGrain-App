<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme.
         Light (not DayNight): the app ships a single light design, so the
         window must never follow the system dark mode — DayNight is what made
         the pre-JS window paint dark grey on dark-mode devices. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Painted from process start until the RN root view draws, so this is
             the colour of the "first frame" the user sees on cold start. -->
        <item name="android:windowBackground">@color/app_background</item>
        <!-- Blocks the OS from auto-inverting the UI on devices with
             force-dark / "dark theme for all apps" enabled. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- Launch theme (androidx.core.splashscreen). This is the theme
         MainActivity starts in, so the very first frame the OS paints is the
         leaf on white - not a blank window. `installSplashScreen()` in
         MainActivity.kt swaps to AppTheme once React Native has drawn, and
         holds the splash until then via setKeepOnScreenCondition. -->
    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <!-- The leaf is a still image; 0 tells the OS not to wait on an
             animation before it is allowed to dismiss. -->
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
