<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest declares android:roundIcon, so launchers that ask for the round
  variant need their own resource. It draws the same adaptive layers as
  ic_launcher.xml: on API 26+ the launcher applies its own mask, so a separate
  pre-cropped circular asset would only fight it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@mipmap/ic_launcher_background"/>
  <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
  <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
