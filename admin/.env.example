# ─────────────────────────────────────────────
# Farmer App - Admin Panel env
# Copy to ".env" and adjust as needed.
# ─────────────────────────────────────────────

# ── API base URL ──
# The admin calls the backend DIRECTLY at this FULL URL (there is no proxy).
# Set the full backend URL for every environment:
#   - Local dev:   http://localhost:5000/api/v1
#   - Production:  https://api.farmer.tcqitsolution.com/api/v1
#
# The backend must allow this admin origin via CORS (it's a cross-origin call).
VITE_API_BASE_URL=http://localhost:5000/api/v1
