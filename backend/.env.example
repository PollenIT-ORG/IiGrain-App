# Farmer App - Backend Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file.

# Server
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed origins for CORS (admin panel, app, etc.)
# Use * only for local development.
CORS_ORIGIN=*
# Base path all API routes are mounted under (e.g. /api/v1).
# Change this to re-version the API without touching code.
API_PREFIX=/api/v1

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Set to true + restart to run pending migrations on boot. Set back to false after.
DB_SYNC=false
# Set to true + restart to seed baseline data (roles). Set back to false after.
DB_SEED=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Auth (JWT)
# Use a long random secret in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change_me_to_a_long_random_secret
# Short-lived ACCESS token (e.g. 15m, 1h). The refresh token keeps sessions alive.
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days (stored in DB).
REFRESH_TOKEN_EXPIRY_DAYS=7

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# SMTP / Email
# When false, OTPs are printed to the terminal (no email sent). Flip to true once
# the SMTP credentials below are filled in.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=Farmer App
SMTP_FROM_EMAIL=no-reply@farmerapp.com

# Base URL for links in emails (e.g. https://admin.farmer.tcqitsolution.com).
# Leave empty and emails are sent without buttons instead of dead links.
APP_URL=

# Rate limiting
# Set RATE_LIMIT_ENABLED=false to turn OFF all rate limiting (testing only).
# Leave as true in production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Multi-tenant (SaaS)
SAAS_ENABLED=false

# Super admin bootstrap (seeded on boot when DB_SEED=true)
SUPER_ADMIN_EMAIL=superadmin@farmerapp.com
SUPER_ADMIN_PASSWORD=change_this_strong_password
SUPER_ADMIN_NAME=Super Admin
