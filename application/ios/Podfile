require 'fileutils'
require 'pathname'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# ─────────────────────────────────────────────────────────────────────────────
# Build React Native core from source instead of the prebuilt xcframework
# ─────────────────────────────────────────────────────────────────────────────
# RN 0.84 defaults to RCT_USE_PREBUILT_RNCORE=1, which downloads a *Release*
# React.xcframework built with NDEBUG. Its debug-only symbols are compiled out,
# but third-party Fabric pods compiled in Debug (RNScreens, RNSVG,
# RNGestureHandler, RNReanimated, RNDateTimePicker) still reference them — so a
# Debug *simulator* build fails with "Undefined symbols for architecture arm64".
# Release device archives link fine, which is why only local development breaks.
#
# Building core from source makes Debug and Release self-consistent. Cost: the
# first build after a `pod install` is considerably slower.
#
# This is a build-time workaround only — it has no effect on runtime behaviour
# or on Maps. If Debug simulator builds link correctly without it on your
# toolchain, it is safe to delete.
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym

  # ─────────────────────────────────────────────────────────────────────────
  # op-sqlite + use_frameworks!
  # ─────────────────────────────────────────────────────────────────────────
  # `use_frameworks!` breaks op-sqlite's compilation: it stops the vendored
  # cpp/sqlite3.c from linking and silently falls back to the OS' embedded
  # SQLite, which is an older version and cannot load extensions. Forcing the
  # pod to build as a static library is the workaround from op-sqlite's own
  # installation docs.
  #
  # Scoped to the use_frameworks! branch on purpose: without that flag the pod
  # already builds as a static library, so this hook would be a no-op.
  pre_install do |installer|
    installer.pod_targets.each do |pod|
      if pod.name.eql?('op-sqlite')
        def pod.build_type
          Pod::BuildType.static_library
        end
      end
    end
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# Google Maps API key → generated xcconfig
# ─────────────────────────────────────────────────────────────────────────────
# The Google Maps iOS SDK needs its key BEFORE the first GMSMapView is created
# (AppDelegate.swift calls GMSServices.provideAPIKey). Native Swift cannot read
# `.env` — react-native-dotenv only rewrites `@env` imports inside the JS
# bundle. So the key has to become a build setting:
#
#   1. Parse `.env` (or $MAPS_API_KEY_IOS, for CI) here, at `pod install` time.
#   2. Write `ios/Config/Env.generated.xcconfig` — GITIGNORED, so the secret
#      never enters version control the way it would if we edited project.pbxproj.
#   3. `#include?` that file from the CocoaPods-generated xcconfigs, which are
#      already the base configuration of the `iiGrain` target. The include is
#      appended LAST so this assignment wins over anything above it.
#   4. Info.plist declares `GMSApiKey = $(MAPS_API_KEY_IOS)`. Xcode expands `$(VAR)`
#      in Info.plist values from build settings at build time.
#   5. AppDelegate.swift reads that Info.plist entry and hands it to the SDK.
#
# If the key is missing the build still succeeds — `GMSApiKey` resolves to an
# empty string and AppDelegate logs a loud warning instead of crashing, so
# non-map work is never blocked by a missing secret.
def resolve_maps_api_key
  from_process_env = ENV['MAPS_API_KEY_IOS']
  return from_process_env.strip unless from_process_env.nil? || from_process_env.strip.empty?

  env_file = File.expand_path('../.env', __dir__)
  return '' unless File.exist?(env_file)

  File.foreach(env_file) do |line|
    stripped = line.strip
    next if stripped.empty? || stripped.start_with?('#')
    key, _, value = stripped.partition('=')
    next unless key.strip == 'MAPS_API_KEY_IOS'
    # Strip optional surrounding quotes; xcconfig values are unquoted literals.
    return value.strip.gsub(/\A["']|["']\z/, '')
  end

  ''
end

def write_maps_xcconfig(api_key)
  config_dir = File.join(__dir__, 'Config')
  FileUtils.mkdir_p(config_dir)
  path = File.join(config_dir, 'Env.generated.xcconfig')
  File.write(path, <<~XCCONFIG)
    // GENERATED by ios/Podfile on `pod install` — DO NOT EDIT, DO NOT COMMIT.
    // Source of truth: .env (or the $MAPS_API_KEY_IOS env var).
    // Consumed by: ios/iiGrain/Info.plist → GMSApiKey → AppDelegate.swift.
    MAPS_API_KEY_IOS = #{api_key}
  XCCONFIG
  path
end

target 'iiGrain' do
  config = use_native_modules!

  # Google Maps on iOS is OPT-IN. react-native-maps' default subspec ('Maps')
  # compiles Apple MapKit only; the podspec's build script then defines
  # HAVE_GOOGLE_MAPS=0 and `provider="google"` SILENTLY falls back to Apple Maps
  # — the app still builds and maps still render, just with Apple tiles and
  # without the custom map style. Declaring the /Google subspec explicitly,
  # BEFORE use_react_native!, pulls in the GoogleMaps + Google-Maps-iOS-Utils
  # pods and flips that flag to 1, so iOS and Android render the same tiles.
  pod 'react-native-maps/Google', :path => '../node_modules/react-native-maps'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # ── Inject MAPS_API_KEY_IOS into the app target's build settings ───────
    api_key = resolve_maps_api_key
    if api_key.empty?
      Pod::UI.warn(
        "MAPS_API_KEY_IOS is not set (checked $MAPS_API_KEY_IOS and .env). " \
        'iOS maps will render blank.'
      )
    end
    xcconfig_path = Pathname.new(write_maps_xcconfig(api_key))

    # `aggregate_targets` are the Pods-<AppTarget> umbrellas; their xcconfigs are
    # the base configuration of the matching target in iiGrain.xcodeproj, so a
    # setting defined here is visible to the app target — no pbxproj edit needed.
    # CocoaPods regenerates these files on every `pod install`, which is why the
    # include is re-appended each time rather than written once.
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_build_configurations.each_key do |config_name|
        generated_xcconfig = aggregate_target.xcconfig_path(config_name)
        next unless File.exist?(generated_xcconfig)

        relative = xcconfig_path.relative_path_from(generated_xcconfig.dirname)
        # `#include?` (optional include) rather than `#include`: a fresh clone
        # that has not run `pod install` yet must still build.
        include_line = %(#include? "#{relative}")

        contents = File.read(generated_xcconfig)
        next if contents.include?(include_line)

        File.write(generated_xcconfig, "#{contents}\n#{include_line}\n")
      end
    end
  end
end
