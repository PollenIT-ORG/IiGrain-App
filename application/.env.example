# ─────────────────────────────────────────────
# iiGrain mobile - client environment template.
# Copy to `.env` and adjust. `.env` itself is gitignored.
# The app uses ONE hosted backend everywhere (no localhost).
# ─────────────────────────────────────────────

# Backend origin (host only, NO trailing slash, NO /api/v1).
API_BASE_URL=https://api.farmer.tcqitsolution.com

# API version prefix (matches backend API_PREFIX).
API_PREFIX=/api/v1

# Request timeout in milliseconds.
API_TIMEOUT=15000

# ─────────────────────────────────────────────
# Google Maps Platform
# ─────────────────────────────────────────────
# TWO keys, one per consumer (see docs/maps/CONFIGURATION.md):
#   MAPS_API_KEY_ANDROID → Gradle  → AndroidManifest com.google.android.geo.API_KEY
#   MAPS_API_KEY_IOS     → Podfile → Config/Env.generated.xcconfig → Info.plist GMSApiKey
# Restrict MAPS_API_KEY_ANDROID by package name + SHA-1 and MAPS_API_KEY_IOS by
# bundle id — see docs/maps/SECURITY.md.
# Leave EMPTY here. This file is committed — put the real keys in `.env` only.
MAPS_API_KEY_ANDROID=
MAPS_API_KEY_IOS=

