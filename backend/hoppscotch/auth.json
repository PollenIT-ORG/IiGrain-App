      "method": "GET",
      "endpoint": "<<baseUrl>>/auth/check-email?email=<<testEmail>>",
      "headers": [],
      "params": [
        {
          "key": "email",
          "value": "<<testEmail>>",
          "active": true
        }
      ],
      "body": {
        "contentType": null,
        "body": null
      },
      "auth": {
        "authType": "none",
        "authActive": false
      },
      "preRequestScript": "",
      "testScript": "pw.test('Status is 200', () => pw.expect(pw.response.status).toBe(200));\nconst d = pw.response.body.data;\n/* d = { email, exists, available } -> block signup when available === false */"
    },
