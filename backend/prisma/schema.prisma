  users_program_enrollments_farmer_idTousers   users                       @relation("program_enrollments_farmer_idTousers", fields: [farmer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  programs                                     programs                    @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([enrollment_id], map: "idx_program_enrollments_enrollment_id")
}

